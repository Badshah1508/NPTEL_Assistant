# ==============================================================================
# StudyPilot AI — Environment Configuration
# ==============================================================================

# Server & Project
PROJECT_NAME="StudyPilot AI"
VERSION="1.0.0"
ENVIRONMENT="development"

# Database Configuration
# Local SQLite default (Zero-configuration):
DATABASE_URL="sqlite+aiosqlite:///./studypilot.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://studypilot_user:secure_password@localhost:5432/studypilot_db"

# Storage Configuration
STORAGE_DIR="./storage"
UPLOAD_MAX_BYTES=262144000  # 250 MB
MAX_EXTRACTED_FILES=200

# AI Provider Settings (Provider-independent layer)
# Options: "mock" (offline deterministic default), "ollama", "openai", "gemini"
AI_PROVIDER="mock"
AI_MODEL="studypilot-deterministic-v1"

# Ollama Local Configuration (if AI_PROVIDER="ollama")
OLLAMA_BASE_URL="http://localhost:11434"

# External API Keys (Optional, if using cloud AI providers)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000/api"
